{
  "name": "vesper-audio",
  "productName": "Vesper Audio",
  "version": "1.3.0",
  "description": "Virtual microphone, local AI noise cancellation and soundboard for Windows",
  "main": "src/main.js",
  "author": "Ayush.ue5",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/vendor.js",
    "start": "electron .",
    "helper": "cargo build --release --manifest-path helper/Cargo.toml",
    "test": "node scripts/test.js",
    "dist": "electron-builder --win nsis portable --publish never",
    "build:df": "node scripts/build-df.js",
    "test:lowend": "node scripts/lowend.js",
    "core": "cargo build --release --manifest-path core/Cargo.toml"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "onnxruntime-web": "^1.30.0",
    "playwright-core": "^1.64.1",
    "qrcode-generator": "^2.0.4"
  },
  "build": {
    "appId": "com.ayushue5.vesperaudio",
    "productName": "Vesper Audio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!src/ui/vendor/ort-wasm-simd-threaded.jsep.*",
      "!src/ui/gate.js",
      "!src/ui/voice.js",
      "!src/ui/vad.js",
      "!src/ui/vad.worker.js",
      "!src/ui/speaker.worker.js",
      "!src/ui/tap.worklet.js",
      "!src/ui/assets/silero_vad.onnx"
    ],
    "extraResources": [
      {
        "from": "helper/target/release/vesper-helper.exe",
        "to": "vesper-helper.exe"
      },
      {
        "from": "core/target/release/vesper-core.exe",
        "to": "vesper-core.exe"
      },
      {
        "from": "android-dist/Vesper-Audio-Connector.apk",
        "to": "connector.apk"
      }
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        "nsis",
        "portable"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "artifactName": "Vesper-Audio-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Vesper-Audio-${version}-portable.${ext}"
    },
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum",
    "publish": [
      {
        "provider": "github",
        "owner": "AroseEditor",
        "repo": "Vesper-Audio"
      }
    ]
  },
  "homepage": "https://github.com/AroseEditor/Vesper-Audio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AroseEditor/Vesper-Audio.git"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
